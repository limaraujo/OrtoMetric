# PRODUCTION ENVIRONMENT
# Copy to .env and populate with real production values
# NEVER commit actual credentials to version control

FLASK_ENV=production
FLASK_DEBUG=False

# Database (Production PostgreSQL - Supabase or similar)
# Must use sslmode=require for production
DATABASE_URL_IPV4=postgresql://user:password@host:5432/ortometric?sslmode=require

# Security - MUST be strong random string (min 64 chars)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-TO-STRONG-RANDOM-SECRET-MIN-64-CHARS
SECRET_KEY=CHANGE-TO-STRONG-RANDOM-SECRET-MIN-64-CHARS

# API Configuration
PORT=5000
FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=WARNING

# Rate Limiting
RATELIMIT_ENABLED=true
