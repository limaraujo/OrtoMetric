# Copie este arquivo para .env e ajuste os valores para seu ambiente local.

# SEGURANÇA - NÃO COMPARTILHAR
FLASK_ENV=development
FLASK_DEBUG=False
JWT_SECRET_KEY=change-this-to-a-long-random-secret-with-32-plus-bytes-min-64-chars

# CONFIGURAÇÃO
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PRODUÇÃO (descomentar quando fazer deploy)
# FLASK_ENV=production
# FLASK_DEBUG=False
# DATABASE_URL=postgresql://user:password@host:5432/ortometric
# JWT_SECRET_KEY=seu-secret-super-seguro-random-64-chars-minimo
# FRONTEND_ORIGINS=https://ortometric.com,https://www.ortometric.com
