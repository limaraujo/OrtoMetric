# DEVELOPMENT ENVIRONMENT
# Copy to .env and adjust for local development

FLASK_ENV=development
FLASK_DEBUG=False

# Database (Local PostgreSQL)
DATABASE_URL_IPV4=postgresql://postgres:password@localhost:5432/ortometric

# Security - Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-dev-secret-key-32-bytes-min
SECRET_KEY=your-dev-secret-key-32-bytes-min

# API Configuration
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional: force IPv4 routing in environments without IPv6 support.
DB_FORCE_IPV4=true
DATABASE_URL_IPV4_IPV4=

# Supabase Pooler (IPv4) settings.
SUPABASE_POOLER_HOST=aws-1-sa-east-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_DBNAME=postgres
SUPABASE_POOLER_USER=postgres.<project-ref>
SUPABASE_POOLER_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATELIMIT_ENABLED=true
